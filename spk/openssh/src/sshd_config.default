# sshd_config for the standalone OpenSSH package (openssh-spk)
# Live copy: /var/packages/openssh/var/etc/sshd_config
# Created once from this template by "openssh-ctl"; never overwritten by package upgrades.
# Always validate after editing:  sudo openssh-ctl check

# --- Network -------------------------------------------------------------
# Keep a port different from the native DSM SSH service until migration is validated.
Port 2222
AddressFamily any
#ListenAddress 0.0.0.0

# --- Host keys (generated by openssh-ctl on first start) -------------------
HostKey /var/packages/openssh/var/etc/ssh_host_ed25519_key
HostKey /var/packages/openssh/var/etc/ssh_host_rsa_key

PidFile /var/run/openssh-spk.pid

# --- Authentication ------------------------------------------------------
# Same behaviour as the DSM native SSH service: passwords, checked by the DSM PAM
# stack (/etc/pam.d/sshd, used read-only): auto block, smart block, IP block list,
# expired/disabled accounts, domain accounts, DSM logging.
# Public keys (~/.ssh/authorized_keys, needs the DSM "user home" service) also work.
# For keys only: set PasswordAuthentication to "no".
UsePAM yes
# PAM service name: "sshd" (OpenSSH default), i.e. /etc/pam.d/sshd
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
# On DSM, only members of "administrators" get a login shell anyway.
AllowGroups administrators
StrictModes yes
MaxAuthTries 3
LoginGraceTime 30

# --- Session -------------------------------------------------------------
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
ClientAliveInterval 300
ClientAliveCountMax 2

# --- Logging (DSM: Log Center / /var/log/messages) -----------------------
SyslogFacility AUTH
LogLevel INFO

Subsystem sftp /var/packages/openssh/target/libexec/sftp-server
