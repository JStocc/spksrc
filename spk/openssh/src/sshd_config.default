# sshd_config for the standalone OpenSSH package (openssh-spk)
# Live copy: /var/packages/openssh/var/etc/sshd_config
# Created once from this template by "openssh-ctl"; never overwritten by package upgrades.
# Always validate after editing:  sudo openssh-ctl check

# --- Network -------------------------------------------------------------
# Keep a port different from the native DSM SSH service until migration is validated.
Port 2222
AddressFamily any
#ListenAddress 0.0.0.0

# --- Host keys (generated by openssh-ctl on first start) -------------------
HostKey /var/packages/openssh/var/etc/ssh_host_ed25519_key
HostKey /var/packages/openssh/var/etc/ssh_host_rsa_key

PidFile /var/run/openssh-spk.pid

# --- Authentication ------------------------------------------------------
# This build has no PAM support: public key authentication only.
PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
# On DSM, only members of "administrators" get a login shell anyway.
AllowGroups administrators
StrictModes yes
MaxAuthTries 3
LoginGraceTime 30

# --- Session -------------------------------------------------------------
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
ClientAliveInterval 300
ClientAliveCountMax 2

# --- Logging (DSM: Log Center / /var/log/messages) -----------------------
SyslogFacility AUTH
LogLevel INFO

Subsystem sftp /var/packages/openssh/target/libexec/sftp-server
