--- sandbox-rlimit.c.orig
+++ sandbox-rlimit.c
@@ -57,7 +57,7 @@
 void
 ssh_sandbox_child(struct ssh_sandbox *box)
 {
-	struct rlimit rl_zero;
+	struct rlimit rl_zero, rl_one = {.rlim_cur = 1, .rlim_max = 1};
 
 	rl_zero.rlim_cur = rl_zero.rlim_max = 0;
 
@@ -67,8 +67,13 @@
 			strerror(errno));
 #endif
 #ifndef SANDBOX_SKIP_RLIMIT_NOFILE
-	if (setrlimit(RLIMIT_NOFILE, &rl_zero) == -1)
-		fatal_f("setrlimit(RLIMIT_NOFILE, { 0, 0 }): %s",
+	/*
+	 * Linux poll(2) fails with EINVAL when nfds > RLIMIT_NOFILE, so zero
+	 * would break the pre-auth packet loop: use one, as the seccomp
+	 * sandbox does.
+	 */
+	if (setrlimit(RLIMIT_NOFILE, &rl_one) == -1)
+		fatal_f("setrlimit(RLIMIT_NOFILE, { 1, 1 }): %s",
 			strerror(errno));
 #endif
 #ifdef HAVE_RLIMIT_NPROC
